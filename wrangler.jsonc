{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "feed-preview",
	"main": "worker.mjs",
	"compatibility_date": "2026-11-19",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/uploads/*",
			"/p/*",
			"/robots.txt"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "feed-preview-db",
			"database_id": "e2fc93b8-3636-4999-9c70-aaa955e1e804",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "feed-preview-media"
		}
	]
}

